{
  "name": "@edgescrum/ds-foundation",
  "version": "0.3.0",
  "description": "Edgescrum design system — foundation layer. DTCG JSON as the source of truth, built to CSS variables and a Tailwind v4 theme. The minimum bar every Edgescrum product meets.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://design-system-storybook-gules.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgescrum/design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./primitives.css": "./dist/css/primitives.css",
    "./theme.css": "./dist/css/theme.css",
    "./tokens.json": "./dist/json/tokens.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "sync:figma": "node scripts/sync-figma.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.1.0"
  }
