{
  "$description": "セマンティック層。CSS 変数名（--background 等）は peco の既存 globals.css と完全一致させる — 差し替え PR の検証条件が「画素差分ゼロ」であるため、名前も値も変えないこと。",
  "background": {
    "$type": "color",
    "$value": "{color.neutral.50}",
    "$description": "ページの地色"
  },
  "foreground": {
    "$type": "color",
    "$value": "{color.neutral.900}",
    "$description": "本文テキスト"
  },
  "accent": {
    "$type": "color",
    "$value": "{color.salmon.500}",
    "$description": "主ボタン・リンク・フォーカスリング"
  },
  "accent-light": {
    "$type": "color",
    "$value": "{color.salmon.300}"
  },
  "accent-dark": {
    "$type": "color",
    "$value": "{color.salmon.600}",
    "$description": "hover / active の濃色"
  },
  "accent-bg": {
    "$type": "color",
    "$value": "{color.salmon.50}",
    "$description": "アクセントの淡色背景（選択状態・フォーカスシャドウ）"
  },
  "success": {
    "$type": "color",
    "$value": "{color.green.line}"
  },
  "card": {
    "$type": "color",
    "$value": "{color.white}",
    "$description": "カード・モーダル等の面"
  },
  "border": {
    "$type": "color",
    "$value": "{color.neutral.200}"
  },
  "muted": {
    "$type": "color",
    "$value": "{color.neutral.500}",
    "$description": "補助テキスト・プレースホルダ"
  },
  "on-accent": {
    "$type": "color",
    "$value": "{color.white}",
    "$description": "accent / success 等の濃色塗りの上の文字色。監査時点では text-white 直書きが 254 回"
  },
  "danger": {
    "$type": "color",
    "$value": "{color.red.600}",
    "$description": "危険・破壊的操作の文字/塗り。DangerZone.tsx の「red-600 に寄せる」裁定を踏襲"
  },
  "danger-bg": {
    "$type": "color",
    "$value": "{color.red.50}",
    "$description": "危険の淡色面"
  },
  "danger-border": {
    "$type": "color",
    "$value": "{color.red.200}",
    "$description": "危険操作の枠線（DangerZone トリガーの border-red-200。DS#11 裁定で Button danger-outline に昇格）"
  },
  "warning": {
    "$type": "color",
    "$value": "{color.amber.700}",
    "$description": "警告の文字色"
  },
  "warning-bg": {
    "$type": "color",
    "$value": "{color.amber.50}",
    "$description": "警告の淡色面"
  },
  "positive": {
    "$type": "color",
    "$value": "{color.green.600}",
    "$description": "UI の成功状態（保存完了・有効等）。LINE 関連 CTA の success（LINE 緑）とは別トークン。green/emerald の二重化はこちらに統一"
  },
  "positive-bg": {
    "$type": "color",
    "$value": "{color.green.50}",
    "$description": "成功の淡色面"
  },
  "info": {
    "$type": "color",
    "$value": "{color.blue.700}",
    "$description": "情報・案内の文字色"
  },
  "info-bg": {
    "$type": "color",
    "$value": "{color.blue.50}",
    "$description": "情報の淡色面"
  },
  "rating": {
    "$description": "5 段評価（アンケートのドライバー評価）の配色。★ positive / warning / danger とは別物で、互いに置き換えない — あちらは「良い・注意・危険」の 3 状態、こちらは 1〜5 の連続スケール。3 色に潰すと隣り合う段の見分けがつかなくなるため、橙（2 段目）と黄（3 段目）をスケール専用に認めている（2026-10-06 裁定・DS#24 の b2）。値は red → orange → yellow → green → green(濃) で、4・5 は 2026-10-06 の emerald → green 統一後の色。unknown は 1〜5 以外が来たときの退避先。",
    "1": {
      "bg": { "$type": "color", "$value": "{color.red.50}" },
      "fg": { "$type": "color", "$value": "{color.red.600}" },
      "border": { "$type": "color", "$value": "{color.red.100}" }
    },
    "2": {
      "bg": { "$type": "color", "$value": "{color.orange.50}" },
      "fg": { "$type": "color", "$value": "{color.orange.600}" },
      "border": { "$type": "color", "$value": "{color.orange.100}" }
    },
    "3": {
      "bg": { "$type": "color", "$value": "{color.yellow.50}" },
      "fg": { "$type": "color", "$value": "{color.yellow.700}" },
      "border": { "$type": "color", "$value": "{color.yellow.100}" }
    },
    "4": {
      "bg": { "$type": "color", "$value": "{color.green.50}" },
      "fg": { "$type": "color", "$value": "{color.green.600}" },
      "border": { "$type": "color", "$value": "{color.green.100}" }
    },
    "5": {
      "bg": { "$type": "color", "$value": "{color.green.50}" },
      "fg": { "$type": "color", "$value": "{color.green.700}" },
      "border": { "$type": "color", "$value": "{color.green.200}" }
    },
    "unknown": {
      "bg": { "$type": "color", "$value": "{color.gray.50}" },
      "fg": { "$type": "color", "$value": "{color.gray.600}" },
      "border": { "$type": "color", "$value": "{color.gray.100}" }
    }
  }
}
